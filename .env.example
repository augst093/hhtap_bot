# ==============================================================================
# HHtap Telegram Bot Configuration
# ==============================================================================

# Токен Telegram-бота от @BotFather (Обязательно)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API-ключ Google Cloud (Опционально. Если оставить пустым, бот работает автономно и бесплатно)
GOOGLE_API_KEY=

# Настройки ИИ-ассистента по продажам (Anymodel.org)
ANYMODEL_API_KEY=your_anymodel_api_key_here
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_MODEL=gpt-6-luna

# Белый список Telegram User ID через запятую.
# Если указать ID (например: 12345678,87654321), бот будет отвечать только этим сотрудникам.
# Если оставить пустым, бот будет доступен всем пользователям.
ADMIN_IDS=

# Геолокация по умолчанию для приоритета поиска (Ташкент, Узбекистан)
DEFAULT_LAT=41.2995
DEFAULT_LNG=69.2401
DEFAULT_RADIUS_METERS=30000
DEFAULT_LANGUAGE=ru
DEFAULT_REGION=uz
